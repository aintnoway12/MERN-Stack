<!DOCTYPE html>
<html lang="en">

<%- include('./components/head.ejs') %>

<body class ="container">
    <%- include('./components/navbar.ejs') %>
    <div>
        <% if(blogs.length) { %>
        <%  blogs.forEach(blog => { %>
        <h1> <%= blog.title %> </h1>
        <p> <%= blog.intro %> </p>
        <% }) %>
        <% }  else {%>
        <h2> No blogs found </h2>
        <% } %>
    </div>
</body>
</html>